# Keeps development, CI, release-tooling, and documentation-site files out of
# the archive Composer installs, so `vendor/studio-design/gesso/` contains only
# what a consumer needs (issue #513).
#
# `composer.json`'s `archive.exclude` declares the same intent, but it only
# governs archives Composer builds itself. This package is distributed as a
# GitHub-generated zipball, which honours `export-ignore` and ignores
# `composer.json` entirely — so this file is what actually ships the policy.
# `tests/Unit/Build/PackageArchivePolicyTest.php` pins both lists in agreement.
#
# Shipped on purpose: src/, bin/, stubs/, docs/ (minus the entries below),
# README.md, UPGRADING.md, CHANGELOG.md, LICENSE, SECURITY.md, composer.json.

/.gitattributes                 export-ignore
/.github                        export-ignore
/.gitignore                     export-ignore
/.markdown-link-check.json      export-ignore
/.markdownlint.jsonc            export-ignore
/.php-cs-fixer.dist.php         export-ignore
/.php-cs-fixer.pest.dist.php    export-ignore
/.php-cs-fixer.shared.php       export-ignore
/.release-please-manifest.json  export-ignore
/AGENTS.md                      export-ignore
/CLAUDE.md                      export-ignore
/CODE_OF_CONDUCT.md             export-ignore
/CONTRIBUTING.md                export-ignore
/benchmarks                     export-ignore
/docs/.vitepress                export-ignore
/docs/public                    export-ignore
/docs/superpowers               export-ignore
/examples                       export-ignore
/images                         export-ignore
/package-lock.json              export-ignore
/package.json                   export-ignore
/phpstan.neon.dist              export-ignore
/phpunit.xml.dist               export-ignore
/release-please-config.json     export-ignore
/renovate.json                  export-ignore
/scripts                        export-ignore
/tests                          export-ignore
