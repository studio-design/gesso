{
  "name": "studio-design/gesso-scramble-example",
  "description": "Laravel contracts generated by Scramble and verified by Gesso.",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo_sqlite": "*",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "dedoc/scramble": "0.13.45",
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.0",
    "studio-design/gesso": "@dev"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": {
        "symlink": true
      }
    }
  ],
  "scripts": {
    "post-autoload-dump": [
      "@php scripts/prepare.php",
      "@php artisan package:discover --ansi"
    ],
    "setup": [
      "@php artisan migrate --force",
      "@export"
    ],
    "export": "@php artisan scramble:export --path=openapi/api.json --fail-on-unknown",
    "test": "@php vendor/bin/phpunit",
    "verify": "@php scripts/verify.php"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
