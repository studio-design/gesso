{
  "openapi": "3.1.0",
  "info": { "title": "Strict required fixture (OAS 3.1)", "version": "1.0.0" },
  "paths": {
    "/nullable-object": {
      "get": {
        "responses": {
          "200": {
            "description": "ok; OAS 3.1 nullable object (type: [object, null]) — a literal JSON null body validates",
            "content": {
              "application/json": {
                "schema": {
                  "type": ["object", "null"],
                  "properties": {
                    "id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/nullable-ref": {
      "get": {
        "responses": {
          "200": {
            "description": "ok; OAS 3.1 nullable $ref written as a union with a null branch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plan": {
                      "anyOf": [{ "$ref": "#/components/schemas/Plan" }, { "type": "null" }]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Plan": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    }
  }
}
