{
  "openapi": "3.1.0",
  "info": { "title": "Ref siblings (3.1)", "version": "1.0.0" },
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Id", "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
            "description": "sibling annotation on a Reference Object"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Id": { "type": "integer" },
      "Name": { "type": "string" },
      "Positions": {
        "type": "object",
        "additionalProperties": { "$ref": "#/components/schemas/Name", "minLength": 5 },
        "not": { "$ref": "#/components/schemas/Name", "maxLength": 1 },
        "allOf": [{ "$ref": "#/components/schemas/Name", "minLength": 6 }],
        "patternProperties": {
          "^p_": { "$ref": "#/components/schemas/Name", "minLength": 7 }
        },
        "$defs": {
          "Inner": { "$ref": "#/components/schemas/Name", "minLength": 8 }
        }
      },
      "Profile": {
        "type": "object",
        "properties": { "bio": { "type": "string" } }
      },
      "Address": {
        "type": "object",
        "required": ["street"],
        "properties": {
          "street": { "$ref": "#/components/schemas/Name", "minLength": 3 }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "name": { "$ref": "#/components/schemas/Name", "minLength": 4 },
          "nickname": {
            "$ref": "#/components/schemas/Name",
            "description": "annotation-only sibling"
          },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Name", "maxLength": 2 }
          },
          "address": { "$ref": "#/components/schemas/Address" },
          "profile": {
            "$ref": "#/components/schemas/Profile",
            "unevaluatedProperties": false
          },
          "token": { "$ref": "#/components/schemas/Name", "readOnly": true },
          "vendor": { "$ref": "#/components/schemas/Name", "x-go-name": "Vendor" },
          "positions": { "$ref": "#/components/schemas/Positions" }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error"],
              "properties": { "error": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
