{
  "openapi": "3.1.0",
  "info": {
    "title": "Strict additional properties fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "responses": {
          "200": {
            "description": "User",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {"type": "string"},
                    "profile": {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "responses": {
          "200": {
            "description": "Catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/patterns": {
      "get": {
        "responses": {
          "200": {
            "description": "Pattern properties",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"}
                  },
                  "patternProperties": {
                    "^x-": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/open": {
      "get": {
        "responses": {
          "200": {
            "description": "Open object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"}
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/unevaluated-open": {
      "get": {
        "responses": {
          "200": {
            "description": "Open object via JSON Schema 2020-12",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"}
                  },
                  "unevaluatedProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/local-draft-07": {
      "get": {
        "responses": {
          "200": {
            "description": "Local Draft 07 override",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"}
                  },
                  "unevaluatedProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/embedded-draft-07": {
      "get": {
        "responses": {
          "200": {
            "description": "Draft 07 embedded schema resource",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$id": "https://example.test/embedded-draft-07",
                      "$schema": "http://json-schema.org/draft-07/schema#",
                      "type": "object",
                      "properties": {
                        "payload": {
                          "type": "object",
                          "properties": {
                            "id": {"type": "string"}
                          },
                          "unevaluatedProperties": true
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/typed-map": {
      "get": {
        "responses": {
          "200": {
            "description": "Typed map",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/all-of": {
      "get": {
        "responses": {
          "200": {
            "description": "Composed object",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {"type": "string"}
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"}
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/all-of-open-schema": {
      "get": {
        "responses": {
          "200": {
            "description": "Composed object with a branch-local open schema",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "payload": {"type": "object"}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"}
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/closed": {
      "get": {
        "responses": {
          "200": {
            "description": "Closed object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
