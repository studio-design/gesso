{
    "openapi": "3.2.0",
    "info": {
        "title": "Form response fixture",
        "version": "1.0.0"
    },
    "paths": {
        "/form-response-styled": {
            "get": {
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/x-www-form-urlencoded": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "tags": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "maxLength": 1
                                            }
                                        }
                                    }
                                },
                                "encoding": {
                                    "tags": {
                                        "style": "form",
                                        "explode": false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/form-response-json-part": {
            "get": {
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/x-www-form-urlencoded": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "address": {
                                            "type": "object",
                                            "required": [
                                                "city"
                                            ]
                                        }
                                    }
                                },
                                "encoding": {
                                    "address": {
                                        "contentType": "application/json"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/form-response-bad-encoding": {
            "get": {
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/x-www-form-urlencoded": {
                                "schema": {
                                    "type": "object"
                                },
                                "encoding": "oops"
                            }
                        }
                    }
                }
            }
        }
    }
}
