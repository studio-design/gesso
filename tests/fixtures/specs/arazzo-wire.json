{
  "openapi": "3.1.0",
  "info": { "title": "Arazzo wire encoding", "version": "1.0.0" },
  "paths": {
    "/things": {
      "parameters": [
        { "name": "csv", "in": "query", "style": "form", "explode": false, "schema": { "type": "array", "items": { "type": "string" } } }
      ],
      "post": {
        "operationId": "sendThing",
        "parameters": [
          { "name": "X-Enabled", "in": "header", "required": true, "schema": { "type": "boolean" } },
          { "name": "tags", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } },
          { "name": "pipes", "in": "query", "style": "pipeDelimited", "schema": { "type": "array", "items": { "type": "string" } } },
          { "name": "filter", "in": "query", "style": "deepObject", "schema": { "type": "object" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["0", "1"], "additionalProperties": { "type": "string" } }
            }
          }
        },
        "responses": { "204": { "description": "Accepted" } }
      }
    }
  }
}
