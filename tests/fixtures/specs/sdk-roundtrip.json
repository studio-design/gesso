{
  "openapi": "3.2.0",
  "info": {
    "title": "SDK round-trip fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/oauth/introspect": {
      "post": {
        "operationId": "introspect",
        "responses": {
          "200": {
            "description": "Introspection response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["active"],
                  "properties": {
                    "active": {"type": "boolean"},
                    "aud": {
                      "oneOf": [
                        {"type": "string"},
                        {
                          "type": "array",
                          "items": {"type": "string"}
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountId}": {
      "get": {
        "operationId": "getAccount",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/no-content": {
      "get": {
        "responses": {
          "204": {"description": "No content"}
        }
      }
    },
    "/text-only": {
      "get": {
        "responses": {
          "200": {
            "description": "Text response",
            "content": {
              "text/plain": {
                "schema": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/missing-schema": {
      "get": {
        "responses": {
          "200": {
            "description": "JSON without a schema",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/stream": {
      "get": {
        "responses": {
          "200": {
            "description": "JSON stream",
            "content": {
              "application/json": {
                "itemSchema": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/custom-operation": {
      "additionalOperations": {
        "CopyThing": {
          "responses": {
            "200": {
              "description": "Custom operation response",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": ["copied"],
                    "properties": {
                      "copied": {"type": "boolean"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
