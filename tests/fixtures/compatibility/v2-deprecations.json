            "v3_target": "laravel.auto_inject_dummy_credentials = 'bearer'",
            "notice": {
                "subject": "The Laravel config key 'auto_inject_dummy_bearer'",
                "replacement": "laravel.auto_inject_dummy_credentials = 'bearer' (in gesso.php)",
                "removed_in": "3.0"
            }
        },
