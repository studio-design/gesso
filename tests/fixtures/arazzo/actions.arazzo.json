{
  "arazzo": "1.1.0",
  "info": {
    "title": "Actions",
    "version": "1.0.0"
  },
  "sourceDescriptions": [
    {
      "name": "petstore",
      "url": "../specs/arazzo-petstore.json"
    }
  ],
  "components": {
    "parameters": {
      "createdPet": {
        "name": "petId",
        "in": "path",
        "value": "$steps.create.outputs.petId"
      }
    },
    "failureActions": {
      "abort": {
        "name": "abort",
        "type": "end"
      }
    }
  },
  "workflows": [
    {
      "workflowId": "endEarly",
      "steps": [
        {
          "stepId": "create",
          "operationId": "createPet",
          "requestBody": {
            "payload": {
              "name": "$inputs.name"
            }
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 201"
            }
          ],
          "outputs": {
            "petId": "$response.body#/id"
          },
          "onSuccess": [
            {
              "name": "done",
              "type": "end",
              "criteria": [
                {
                  "condition": "$response.body#/name == 'Stop'"
                }
              ]
            }
          ]
        },
        {
          "stepId": "read",
          "operationId": "getPet",
          "parameters": [
            {
              "reference": "$components.parameters.createdPet"
            }
          ],
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ]
        }
      ],
      "outputs": {
        "petId": "$steps.create.outputs.petId"
      }
    },
    {
      "workflowId": "skipForward",
      "steps": [
        {
          "stepId": "create",
          "operationId": "createPet",
          "requestBody": {
            "payload": {
              "name": "$inputs.name"
            }
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 201"
            }
          ],
          "outputs": {
            "petId": "$response.body#/id"
          },
          "onSuccess": [
            {
              "name": "skipRead",
              "type": "goto",
              "stepId": "list"
            }
          ]
        },
        {
          "stepId": "read",
          "operationId": "getPet",
          "parameters": [
            {
              "name": "petId",
              "in": "path",
              "value": 1
            }
          ]
        },
        {
          "stepId": "list",
          "operationId": "listPets",
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ]
        }
      ]
    },
    {
      "workflowId": "loopBack",
      "steps": [
        {
          "stepId": "create",
          "operationId": "createPet",
          "requestBody": {
            "payload": {
              "name": "$inputs.name"
            }
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 201"
            }
          ],
          "outputs": {
            "petId": "$response.body#/id"
          }
        },
        {
          "stepId": "read",
          "operationId": "getPet",
          "parameters": [
            {
              "reference": "$components.parameters.createdPet"
            }
          ],
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ],
          "onSuccess": [
            {
              "name": "again",
              "type": "goto",
              "stepId": "create",
              "criteria": [
                {
                  "condition": "$response.body#/id == 1"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "workflowId": "routeAroundFailure",
      "steps": [
        {
          "stepId": "read",
          "operationId": "getPet",
          "parameters": [
            {
              "name": "petId",
              "in": "path",
              "value": 999
            }
          ],
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ],
          "onFailure": [
            {
              "name": "recover",
              "type": "goto",
              "stepId": "list",
              "criteria": [
                {
                  "condition": "$statusCode == 404"
                }
              ]
            }
          ]
        },
        {
          "stepId": "list",
          "operationId": "listPets",
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ]
        }
      ],
      "outputs": {
        "never": "$inputs.name"
      }
    },
    {
      "workflowId": "abortViaComponent",
      "failureActions": [
        {
          "reference": "$components.failureActions.abort"
        }
      ],
      "steps": [
        {
          "stepId": "read",
          "operationId": "getPet",
          "parameters": [
            {
              "name": "petId",
              "in": "path",
              "value": 999
            }
          ],
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ]
        },
        {
          "stepId": "list",
          "operationId": "listPets"
        }
      ]
    },
    {
      "workflowId": "recoverFromUnboundPath",
      "steps": [
        {
          "stepId": "read",
          "operationId": "getPet",
          "onFailure": [
            {
              "name": "cleanup",
              "type": "goto",
              "stepId": "list"
            }
          ]
        },
        {
          "stepId": "list",
          "operationId": "listPets"
        }
      ]
    },
    {
      "workflowId": "recoveryAlsoFails",
      "steps": [
        {
          "stepId": "read",
          "operationId": "getPet",
          "parameters": [
            {
              "name": "petId",
              "in": "path",
              "value": 999
            }
          ],
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ],
          "onFailure": [
            {
              "name": "recover",
              "type": "goto",
              "stepId": "create"
            }
          ]
        },
        {
          "stepId": "create",
          "operationId": "createPet",
          "requestBody": {
            "payload": {
              "name": "$inputs.missing"
            }
          }
        }
      ]
    }
  ]
}
