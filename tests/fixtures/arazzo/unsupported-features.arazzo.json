{
  "arazzo": "1.1.0",
  "info": {
    "title": "t",
    "version": "1.0.0"
  },
  "sourceDescriptions": [
    {
      "name": "petstore",
      "url": "../specs/arazzo-petstore.json"
    }
  ],
  "workflows": [
    {
      "workflowId": "everything",
      "dependsOn": [
        "other"
      ],
      "steps": [
        {
          "stepId": "nested",
          "workflowId": "other"
        },
        {
          "stepId": "channel",
          "channelPath": "{$sourceDescriptions.petstore.url}#/channels/x"
        },
        {
          "stepId": "create",
          "operationId": "createPet",
          "onSuccess": [
            {
              "name": "done",
              "type": "end"
            }
          ],
          "onFailure": [
            {
              "name": "stop",
              "type": "end"
            }
          ],
          "parameters": [
            {
              "reference": "$components.parameters.shared"
            },
            {
              "name": "raw",
              "in": "querystring",
              "value": "a=1"
            },
            {
              "name": "X-Pick",
              "in": "header",
              "value": {
                "context": "$inputs.doc",
                "selector": "$.id"
              }
            }
          ],
          "requestBody": {
            "contentType": "application/xml",
            "payload": "<pet/>",
            "replacements": [
              {
                "target": "/name",
                "value": "x"
              }
            ]
          },
          "successCriteria": [
            {
              "condition": "^2",
              "context": "$statusCode",
              "type": "regex"
            }
          ],
          "outputs": {
            "other": "$workflows.other.outputs.id",
            "early": "$steps.later.outputs.x"
          }
        },
        {
          "stepId": "later",
          "operationId": "listPets",
          "outputs": {
            "x": "$statusCode"
          }
        }
      ]
    }
  ]
}
