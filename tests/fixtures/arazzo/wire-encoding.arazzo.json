{
  "arazzo": "1.1.0",
  "info": { "title": "Wire encoding", "version": "1.0.0" },
  "sourceDescriptions": [
    { "name": "wire", "url": "../specs/arazzo-wire.json" }
  ],
  "workflows": [
    {
      "workflowId": "send",
      "steps": [
        {
          "stepId": "send",
          "operationId": "sendThing",
          "parameters": [
            { "name": "X-Enabled", "in": "header", "value": false },
            { "name": "tags", "in": "query", "value": ["red", "blue"] },
            { "name": "csv", "in": "query", "value": ["a", "b"] },
            { "name": "pipes", "in": "query", "value": ["x", "y"] }
          ],
          "requestBody": { "payload": { "0": "zero", "1": "$inputs.one" } },
          "successCriteria": [
            { "condition": "$statusCode == 204" },
            { "condition": "$request.header.Content-Type == 'application/json'" }
          ]
        }
      ]
    },
    {
      "workflowId": "deepObjectQuery",
      "steps": [
        {
          "stepId": "send",
          "operationId": "sendThing",
          "parameters": [
            { "name": "X-Enabled", "in": "header", "value": true },
            { "name": "filter", "in": "query", "value": "x" }
          ],
          "requestBody": { "payload": { "0": "zero", "1": "one" } }
        }
      ]
    }
  ]
}
