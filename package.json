{
  "name": "gesso-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:verify-accessibility": "node scripts/verify-docs-accessibility.mjs",
    "docs:anchor-probe": "node scripts/emit-anchor-probe.mjs",
    "docs:verify-base": "node scripts/verify-docs-base.mjs",
    "docs:verify-tombo": "node scripts/verify-tombo-vendor.mjs",
    "docs:verify-version": "node scripts/verify-docs-version.mjs",
    "docs:links": "lychee --no-progress README.md CONTRIBUTING.md UPGRADING.md SECURITY.md 'docs/*.md' 'docs/**/*.md' 'examples/*/README.md' 'docs/.vitepress/dist/*.md'"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "8.2.2"
  }
}
